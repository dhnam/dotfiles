{{- if eq .chezmoi.os "windows" -}}
# $PROFILE이 공용 프로필(~/.config/powershell/profile.ps1)을 불러오도록 한 줄을 보장한다.
# apply할 때마다 돌지만, 이미 들어 있으면 아무것도 하지 않는다.
#
# $PROFILE 자체를 chezmoi로 관리하지 않는 이유: PowerToys와 coreutils가 이 파일에 자기 블록을
# 써넣고 갱신하기 때문에, 통째로 관리하면 apply할 때마다 서로 덮어쓰게 된다.

$profilePath = $PROFILE.CurrentUserCurrentHost   # 문서 폴더가 OneDrive로 옮겨진 PC에서도 맞는 경로
$marker = 'chezmoi: shared profile'
$loader = '$__p = "$HOME\.config\powershell\profile.ps1"; if (Test-Path $__p) { . $__p }  # ' + $marker

$text = ''
if (Test-Path -LiteralPath $profilePath) {
    $text = Get-Content -LiteralPath $profilePath -Raw
    if (-not $text) { $text = '' }
}
if ($text.Contains($marker)) { exit 0 }

# 예전 방식(프로필을 통째로 관리)에서 넘어오는 경우: 공용 프로필과 겹치는 내용을 걷어내고
# 설치 프로그램이 써넣은 블록만 남긴다. 원본은 .pre-split.bak으로 보관한다.
if ($text -match 'mise activate pwsh') {
    $backup = "$profilePath.pre-split.bak"
    if (-not (Test-Path -LiteralPath $backup)) { Copy-Item -LiteralPath $profilePath -Destination $backup }
    $keep = @()
    foreach ($rx in @(
        '(?ms)^#f45873b3-b655-43a6-b217-97c00aa0db58.*?^#f45873b3-b655-43a6-b217-97c00aa0db58[^\r\n]*',            # PowerToys CommandNotFound
        '(?ms)^# DO NOT MODIFY -- coreutils -- 60b36fc6[^\r\n]*\r?\n.*?^# DO NOT MODIFY -- coreutils -- 60b36fc6[^\r\n]*'  # coreutils
    )) {
        $m = [regex]::Match($text, $rx)
        if ($m.Success) { $keep += ($m.Value -split '\r?\n' | Where-Object { $_ -notmatch 'starship init' }) -join "`r`n" }
    }
    $text = $keep -join "`r`n`r`n"
    Write-Host "PowerShell 프로필을 정리했습니다. 원본: $backup"
}

$text = $text.TrimEnd("`r", "`n")
if ($text) { $text += "`r`n`r`n" }
$text += $loader + "`r`n"

New-Item -ItemType Directory -Force -Path (Split-Path -LiteralPath $profilePath) | Out-Null
if (Test-Path -LiteralPath $profilePath) { Set-ItemProperty -LiteralPath $profilePath -Name IsReadOnly -Value $false }
[System.IO.File]::WriteAllText($profilePath, $text, [System.Text.UTF8Encoding]::new($false))
Write-Host "PowerShell 프로필에 공용 프로필 로더를 추가했습니다: $profilePath"
{{- end -}}
